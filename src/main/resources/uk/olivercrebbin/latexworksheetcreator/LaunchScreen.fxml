<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uk.olivercrebbin.latexworksheetcreator.LauncherController">
   <center>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="152.0" prefWidth="485.0" spacing="15.0">
         <children>
            <Label text="Latex Worksheet Creator">
               <font>
                  <Font name="AppleMyungjo Regular" size="41.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="0.0" prefWidth="600.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#LoadSave" prefHeight="26.0" prefWidth="200.0" text="Open Saved">
                     <font>
                        <Font name="AppleMyungjo Regular" size="13.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#newFile" prefHeight="26.0" prefWidth="200.0" text="New File">
                     <font>
                        <Font name="AppleMyungjo Regular" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <top>
      <MenuBar fx:id="menuBar" useSystemMenuBar="true" BorderPane.alignment="CENTER" />
   </top>
</BorderPane>
